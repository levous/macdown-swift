    "MacDown can’t create a file for the clicked link because the current file is not saved anywhere yet. Save the current file somewhere to enable this feature." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown nemůže vytvořit soubor pro odkaz, na který jste klikli, protože aktuální soubor ještě nikde není uložen. Chcete-li tuto funkci použít, aktuální soubor uložte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kan ikke oprette en fil til det klikkede link, fordi den aktuelle fil ikke er gemt endnu. Gem den aktuelle fil for at bruge denne funktion."
          }
        },
        "da-DK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kan ikke oprette en fil til det klikkede link, fordi den aktuelle fil ikke er gemt endnu. Gem den aktuelle fil for at bruge denne funktion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kann keine Datei für den angeklickten Link erstellen, da die aktuelle Datei noch nicht gespeichert wurde. Speichere die aktuelle Datei, um diese Funktion zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown no puede crear un archivo para el enlace pulsado porque el archivo actual aún no se ha guardado. Guarda el archivo actual para usar esta función."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown ei saa klõpsatud lingi jaoks faili luua, kuna praegust faili pole veel kuhugi salvestatud. Selle funktsiooni kasutamiseks salvestage praegune fail."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown ei voi luoda tiedostoa napsautetulle linkille, koska nykyistä tiedostoa ei ole vielä tallennettu. Tallenna nykyinen tiedosto käyttääksesi tätä toimintoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown ne peut pas créer de fichier pour le lien cliqué, car le fichier actuel n’a pas encore été enregistré. Enregistrez le fichier actuel pour activer cette fonction."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown getur ekki búið til skrá fyrir tengilinn sem smellt var á því núverandi skrá hefur ekki verið vistuð. Vistaðu núverandi skrá til að virkja þennan eiginleika."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown non può creare un file per il link selezionato perché il file attuale non è ancora stato salvato. Salva il file attuale per abilitare questa funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在のファイルがまだ保存されていないため、MacDown はクリックしたリンクのファイルを作成できません。この機能を使うには、現在のファイルを保存してください。"
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "현재 파일이 아직 저장되지 않았기 때문에 MacDown이 클릭한 링크에 대한 파일을 생성할 수 없습니다. 이 기능을 사용하려면 현재 파일을 저장하십시오."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kan ikke opprette en fil for lenken du klikket på, fordi den gjeldende filen ikke er lagret ennå. Lagre den gjeldende filen for å bruke denne funksjonen."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kan geen bestand aanmaken voor de aangeklikte link, omdat het huidige bestand nog nergens is bewaard. Bewaar het huidige bestand om deze functie te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O MacDown não pode criar um arquivo para o link clicado porque o arquivo atual ainda não foi salvo. Salve o arquivo atual para ativar este recurso."
          }
        },
        "ru-RU" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown не может создать файл для этой ссылки, так как текущий файл ещё не сохранён. Сохраните текущий файл, чтобы использовать эту функцию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown nemôže vytvoriť súbor pre kliknutý odkaz, pretože aktuálny súbor ešte nie je nikde uložený. Ak chcete túto funkciu použiť, aktuálny súbor uložte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacDown kan inte skapa en fil för länken du klickade på eftersom den aktuella filen inte har sparats än. Spara den aktuella filen för att använda den här funktionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geçerli dosya henüz kaydedilmediği için MacDown tıklanan bağlantı için dosya oluşturamıyor. Bu özelliği kullanmak için geçerli dosyayı kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "由于当前文件尚未存储，MacDown 无法为所点按的链接创建文件。请先存储当前文件以使用此功能。"
          }
        },
        "zh-Hant" : {
