    "Please check the path of your link is correct. Turn on “Automatically create link targets” If you want MacDown to create nonexistent link targets for you." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zkontrolujte, zda je cesta odkazu správná. Pokud chcete, aby MacDown vytvářel neexistující cíle odkazů za vás, zapněte „Automaticky vytvářet odkazy na neexistující soubory“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollér, at linkets sti er korrekt. Slå “Opret automatisk filer til link-mål” til, hvis MacDown skal oprette ikke-eksisterende link-mål for dig."
          }
        },
        "da-DK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollér, at linkets sti er korrekt. Slå “Opret automatisk filer til link-mål” til, hvis MacDown skal oprette ikke-eksisterende link-mål for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte prüfe, ob der Pfad des Links stimmt. Aktiviere „Automatisch Dateien für Links erzeugen“, wenn MacDown nicht vorhandene Linkziele für dich erstellen soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprueba que la ruta del enlace sea correcta. Activa “Crear automáticamente los archivos apuntados por los enlaces” si quieres que MacDown cree los destinos de enlace que no existan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollige, kas lingi asukoht on õige. Lülitage sisse „Loo linkide sihtfailid automaatselt“, kui soovite, et MacDown looks puuduvad lingi sihtfailid teie eest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tarkista, että linkin polku on oikein. Laita päälle ”Luo linkkien kohdetiedostot automaattisesti”, jos haluat MacDownin luovan puuttuvat linkkien kohteet puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez que le chemin du lien est correct. Activez « Créer automatiquement les fichiers des cibles de lien » si vous voulez que MacDown crée pour vous les cibles de lien inexistantes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Athugaðu hvort slóð tengilsins sé rétt. Kveiktu á „Búa sjálfvirkt til skrár fyrir tengla“ ef þú vilt að MacDown búi til markskrár tengla sem ekki eru til."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Controlla che il percorso del link sia corretto. Attiva “Crea automaticamente file per link di destinazione” se vuoi che MacDown crei per te le destinazioni dei link inesistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リンクのパスが正しいか確認してください。存在しないリンク先を MacDown に作成させたい場合は、「リンク先のファイルを自動的に作成」をオンにしてください。"
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "링크 경로가 올바른지 확인하십시오. 존재하지 않는 링크 대상을 MacDown이 생성하도록 하려면 '링크 대상 파일 자동 생성'을 켜십시오."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontroller at stien til lenken er riktig. Slå på «Lag filer for lenkemål automatisk» hvis du vil at MacDown skal opprette lenkemål som ikke finnes."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Controleer of het pad van de link klopt. Schakel ‘Creëer automatisch bestanden voor linkdoelen’ in als je wilt dat MacDown niet-bestaande linkdoelen voor je aanmaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verifique se o caminho do link está correto. Ative “Criar automaticamente arquivos para os links de destino” se quiser que o MacDown crie os destinos de link inexistentes."
          }
        },
        "ru-RU" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проверьте правильность пути ссылки. Включите «Автоматически создавать файлы для ссылок», если хотите, чтобы MacDown создавал несуществующие файлы ссылок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skontrolujte, či je cesta odkazu správna. Ak chcete, aby MacDown vytváral neexistujúce ciele odkazov za vás, zapnite „Automaticky vytvárať súbory pre ciele odkazov“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollera att länkens sökväg är korrekt. Aktivera ”Skapa filer för länkmål automatiskt” om du vill att MacDown ska skapa länkmål som inte finns."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bağlantının yolunun doğru olduğunu kontrol edin. MacDown'ın var olmayan bağlantı hedeflerini sizin için oluşturmasını istiyorsanız “Bağlantı hedefleri için dosyaları otomatik oluştur” seçeneğini açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请检查链接路径是否正确。如果希望 MacDown 为你创建不存在的链接目标，请打开“自动创建链接目标文件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請檢查連結路徑是否正確。若希望 MacDown 為你建立不存在的連結目標，請開啟「自動新增檔案於連結目標」。"
          }
        }
      }
    },
